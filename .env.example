# ========== 必填配置 ==========
# OpenAI API 密钥（DeepSeek 也用这个）
OPENAI_API_KEY=your-api-key-here

# ========== LLM 配置 ==========
# 模型名称
OPENAI_MODEL=deepseek-chat

# API 基础 URL
OPENAI_BASE_URL=https://api.deepseek.com/v1

# Reasoning Effort（推理深度）
# 可选值: low / medium / high，留空则不启用
# 仅 DeepSeek 等支持此参数的模型有效
REASONING_EFFORT=

# ========== 服务配置 ==========
# 服务监听端口（默认 5000）
# LISTEN_PORT=5000

# 访问令牌（可选，保护 API 不被他人使用）
# ACCESS_TOKEN=your_secret_token_here

# ========== 搜索配置 ==========
# 搜索引擎选择: tavily 或 exa（根据你配置的 API 自动判断）
# Tavily API 密钥（推荐，免费额度）
# TAVILY_API_KEY=your-tavily-api-key-here

# Exa AI API 密钥（可选，替代 Tavily）
# EXA_API_KEY=your-exa-api-key-here

# ========== 缓存配置 ==========
# 缓存随机重试概率（默认 0.1，即 10% 概率重试）
# CACHE_RETRY_PROBABILITY=0.1

# ========== 置信度配置 ==========
# 置信度阈值（0-1 之间的数字，低于此值触发联网搜索）
# CONFIDENCE_THRESHOLD=0.7
